            "properties": {
              "source_bundle": {
                "type": "string"
              },
              "source_sha": {
                "type": "string"
              },
              "target_sha": {
                "type": "string"
              },
              "proof_method": {
                "type": "string"
              },
              "unaffected_surfaces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "documentation",
                    "domain",
                    "api_contract",
                    "authorization_iam",
                    "database_schema",
                    "migration",
                    "concurrency",
                    "frontend_behavior",
                    "visual_ux",
                    "accessibility",
                    "integration",
                    "provider_outbox",
                    "observability",
                    "deployment_runtime",
                    "release",
                    "clinical_data",
                    "ai_analysis",
                    "infrastructure"
