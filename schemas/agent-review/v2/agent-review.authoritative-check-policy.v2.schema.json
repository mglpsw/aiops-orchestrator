{
  "$defs": {
    "AuthoritativeCheckEntryV2": {
      "additionalProperties": false,
      "description": "One required check and the single producer entitled to speak for it.",
      "properties": {
        "check_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Check Name",
          "type": "string"
        },
        "job_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Job Name",
          "type": "string"
        },
        "origin_rules": {
          "$ref": "#/$defs/OriginRulesV2"
        },
        "permitted_conclusions": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "success",
              "type": "string"
            },
            {
              "const": "failure",
              "type": "string"
            }
          ],
          "title": "Permitted Conclusions",
          "type": "array"
        },
        "permitted_execution_modes": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "reexecuted_in_producer_run",
                  "upstream_artifact_republished",
                  "independent_data_only_host_tool"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permitted Execution Modes"
        },
        "producer_kind": {
          "enum": [
            "sha_pinned_reusable_workflow",
            "base_owned_workflow_run"
          ],
          "title": "Producer Kind",
          "type": "string"
        },
        "producer_workflow": {
          "$ref": "#/$defs/ProducerWorkflowIdentityV2"
        },
        "producer_workflow_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Producer Workflow Ref",
          "type": "string"
        },
        "verifier_identity": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Verifier Identity",
          "type": "string"
        },
        "workflow_path": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[^*?\\[\\]]+$",
          "title": "Workflow Path",
          "type": "string"
        }
      },
      "required": [
        "check_name",
        "workflow_path",
        "job_name",
        "verifier_identity",
        "producer_kind",
        "producer_workflow",
        "producer_workflow_ref",
        "permitted_conclusions",
        "origin_rules"
      ],
      "title": "AuthoritativeCheckEntryV2",
      "type": "object"
    },
    "AuthoritativeCheckPolicyIdentityV2": {
      "additionalProperties": false,
      "properties": {
        "repo": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repo",
          "type": "string"
        }
      },
      "required": [
        "repo"
      ],
      "title": "AuthoritativeCheckPolicyIdentityV2",
      "type": "object"
    },
    "ExecutedTreeRuleV2": {
      "description": "How the tree a CI run actually executed is bound to the run identity.\n\n`SYNTHETIC_MERGE_PARENTAGE` is GitHub's `pull_request` semantics: the run\nexecutes a synthetic merge commit whose parents are exactly\n`[base_sha, head_sha]`. `EXPLICIT_TESTED_TREE` covers every other origin,\nwhere that assumption does NOT hold and the binding must be stated rather\nthan inherited.",
      "enum": [
        "synthetic_merge_parentage",
        "explicit_tested_tree"
      ],
      "title": "ExecutedTreeRuleV2",
      "type": "string"
    },
    "OriginRulesV2": {
      "additionalProperties": false,
      "description": "Which `RunOriginV2` event types this entry may be promoted under.\n\nAn explicit, closed object rather than a free map: an open map would let a\ntarget introduce an origin key the engine has never heard of, and it cannot\nforbid unknown properties in the published schema. `None` means \"this\norigin is not authorised here\", which is the fail-closed default -- an\norigin is opted IN, never assumed.",
      "properties": {
        "manual": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutedTreeRuleV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pull_request": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutedTreeRuleV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pull_request_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutedTreeRuleV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "replay": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutedTreeRuleV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "OriginRulesV2",
      "type": "object"
    },
    "ProducerWorkflowIdentityV2": {
      "additionalProperties": false,
      "description": "The immutable identity a base-owned policy pins.\n\n`sha` is a full 40-character commit SHA by type. A short SHA or a branch\nname would be mutable, and the entire point of this contract is that the\nproducer cannot be swapped after the policy was written.",
      "properties": {
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[^*?\\[\\]]+$",
          "title": "Path",
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Sha",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "path",
        "sha"
      ],
      "title": "ProducerWorkflowIdentityV2",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authoritative_checks": {
      "items": {
        "$ref": "#/$defs/AuthoritativeCheckEntryV2"
      },
      "minItems": 1,
      "title": "Authoritative Checks",
      "type": "array"
    },
    "identity": {
      "$ref": "#/$defs/AuthoritativeCheckPolicyIdentityV2"
    },
    "schema_id": {
      "const": "agent-review.authoritative-check-policy.v2",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "const": "repo-policy",
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "source",
    "identity",
    "authoritative_checks"
  ],
  "title": "AuthoritativeCheckPolicyV2",
  "type": "object"
}
