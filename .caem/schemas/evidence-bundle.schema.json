                }
              }
            },
            "additionalProperties": false
          },
          "approval": {
            "type": "object",
            "required": [
              "approved_by",
              "reason"
            ],
            "properties": {
              "approved_by": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              },
              "compensating_control": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "inherited"
                }
              }
            },
            "then": {
              "required": [
                "inheritance"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "result": {
                  "const": "skipped_with_approval"
                }
              }
            },
            "then": {
              "required": [
                "approval"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "sanitization": {
      "type": "object",
      "required": [
        "policy",
        "data_classification",
        "secret_scan",
        "personal_or_clinical_identifiers_present"
