{
  "$defs": {
    "TrustedCheckAuthorityV2": {
      "enum": [
        "trusted",
        "untrusted_advisory"
      ],
      "title": "TrustedCheckAuthorityV2",
      "type": "string"
    },
    "TrustedCheckOutcomeV2": {
      "description": "Every way a trusted check can conclude. Only SUCCESS/FAILURE are\n\"resolved\" (the check ran to completion and produced a real verdict);\nthe other four are environmental and can never promote to a\n`RequiredCheckResultV2` -- see `promote_trusted_check_to_required_v2`.",
      "enum": [
        "success",
        "failure",
        "timeout",
        "oom",
        "cancelled",
        "infra_failure"
      ],
      "title": "TrustedCheckOutcomeV2",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Artifact Sha256"
    },
    "authority": {
      "$ref": "#/$defs/TrustedCheckAuthorityV2"
    },
    "check_name": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Check Name",
      "type": "string"
    },
    "harness_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Harness Digest",
      "type": "string"
    },
    "head_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Head Sha",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/TrustedCheckOutcomeV2"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_id": {
      "const": "agent-review.trusted-check-result.v2",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "head_sha",
    "check_name",
    "authority",
    "outcome",
    "harness_digest",
    "artifact_sha256",
    "result_sha256"
  ],
  "title": "TrustedCheckResultV2",
  "type": "object"
}
