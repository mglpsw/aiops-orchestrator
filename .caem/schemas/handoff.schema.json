{
  "$id": "https://caem.local/schemas/handoff.schema.json",
  "title": "CAEM multi-agent handoff",
  "type": "object",
  "required": [
    "handoff_id",
    "task_id",
    "generated_at",
    "from",
    "to",
    "state",
    "identity",
    "changes",
    "evidence_refs",
    "blockers",
    "decisions",
    "authority",
    "next_minimum_action",
    "live_revalidation_required"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "handoff_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "state": {
      "type": "object",
      "required": [
        "implementation",
        "validation",
        "change_request",
        "slice",
        "release",
        "deployment",
        "observation"
