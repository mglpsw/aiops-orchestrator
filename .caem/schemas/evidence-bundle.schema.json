              "focused-tests",
              "type-lint-build",
              "full-affected-suite",
              "postgres-real",
              "negative-authorization",
              "concurrency",
              "visual-contract",
              "accessibility",
              "canonical-dev-smoke",
              "slice-journey",
              "provider-sandbox",
              "release-attestation",
              "production-health",
              "security-sanitization",
              "ai-contract"
            ]
          },
          "environment": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "documentation",
                  "local",
                  "ci",
                  "ephemeral",
                  "canonical_dev",
                  "external_sandbox",
                  "production",
                  "local_or_ci",
                  "local_ci_and_ephemeral"
                ]
              },
              "profile_ref": {
                "type": "string"
              },
              "runner": {
                "type": "string"
              },
              "runtime_digest": {
                "type": "string"
              }
