{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "MPACK task definition; contains no execution result",
  "required": [
    "schema_version",
    "task_id",
    "lifecycle",
    "subject",
    "objective",
    "scope_in",
    "scope_out",
    "claims",
    "profiles",
    "evidence_requirements",
    "stop_conditions",
    "authorization_record"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "enum": [
        "DRAFT_PLAN",
        "FROZEN_TASK"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base",
        "head",
        "tree",
        "context"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "tree": {
          "type": "string"
        },
        "context": {
          "type": "string"
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope_in": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_out": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "proposition",
          "basis",
          "domain",
          "non_claims",
          "limitations"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "proposition": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "non_claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authorization_record": {
      "type": "string"
    }
  }
}
