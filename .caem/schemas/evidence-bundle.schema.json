{
  "$id": "https://caem.local/schemas/evidence-bundle.schema.json",
  "title": "CAEM evidence bundle",
  "type": "object",
  "required": [
    "bundle_id",
    "task_id",
    "generated_at",
    "identity",
    "gate_runs",
    "sanitization",
    "actions",
    "limitations",
    "worktree"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "bundle_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "identity": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "base_sha": {
          "type": "string"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tested_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "synthetic_merge_sha": {
          "type": "string"
        },
        "merge_commit_sha": {
          "type": "string"
        },
        "release_commit_sha": {
          "type": "string"
        },
        "deployed_revision": {
          "type": "string"
        },
        "artifact_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "migration_head": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "gate_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "gate_id",
          "environment",
          "subject",
          "result"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "gate_id": {
            "type": "string",
            "enum": [
