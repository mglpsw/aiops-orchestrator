{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authoritative_diff_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Authoritative Diff Sha256",
      "type": "string"
    },
    "base_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Base Sha",
      "type": "string"
    },
    "head_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Head Sha",
      "type": "string"
    },
    "manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Hash",
      "type": "string"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "title": "Repository",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_id": {
      "const": "agent-review.manifest-diff-binding.v2",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "const": "aiops-review-bind-manifest-diff-v2",
      "title": "Source",
      "type": "string"
    },
    "tested_merge_sha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tested Merge Sha"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "source",
    "run_id",
    "manifest_hash",
    "repository",
    "base_sha",
    "head_sha",
    "tested_merge_sha",
    "authoritative_diff_sha256"
  ],
  "title": "ManifestDiffBindingV2",
  "type": "object"
}
