      ],
      "properties": {
        "consumed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_consumed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transferred": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "next_minimum_action": {
      "type": "string",
      "minLength": 1
    },
    "live_revalidation_required": {
      "const": true
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-generated-from": "policy/caem-policy.json",
  "x-caem-version": "2.1.0"
}
