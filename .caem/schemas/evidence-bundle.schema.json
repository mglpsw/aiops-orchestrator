        "data_classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "restricted_workforce",
            "restricted_infrastructure",
            "restricted_code_and_operations",
            "restricted_clinical"
          ]
        },
        "secret_scan": {
          "type": "object",
          "required": [
            "result"
          ],
          "properties": {
            "tool": {
              "type": "string"
            },
            "result": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "not_applicable"
              ]
