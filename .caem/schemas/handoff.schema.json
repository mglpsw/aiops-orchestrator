        },
        "validation": {
          "type": "string",
          "enum": [
            "not_started",
            "partial",
            "passed",
            "failed",
            "unavailable",
            "stale"
          ]
        },
        "change_request": {
          "type": "string",
          "enum": [
            "none",
            "draft",
            "ready",
            "approved",
            "merged",
            "closed"
          ]
        },
        "slice": {
          "type": "string",
          "enum": [
            "not_started",
            "in_progress",
            "implemented_not_closed",
            "closed",
            "blocked"
          ]
        },
        "release": {
          "type": "string",
          "enum": [
            "not_created",
            "candidate",
            "approved",
            "published",
            "withdrawn"
          ]
        },
        "deployment": {
          "type": "string",
          "enum": [
            "not_deployed",
            "in_progress",
            "completed",
            "rolled_back",
            "failed"
          ]
        },
        "observation": {
          "type": "string",
          "enum": [
            "not_applicable",
            "unknown",
            "healthy",
            "degraded",
            "unhealthy"
          ]
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "base_sha": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "tested_sha": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "summary"
        ],
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "product",
              "regression",
              "preexisting",
              "environment",
              "gate_unavailable",
              "contract",
              "authority",
              "security",
              "data_integrity",
              "unknown"
            ]
          },
          "summary": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision",
          "status"
        ],
        "properties": {
          "decision": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "taken",
              "not_taken",
              "deferred"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "consumed",
        "not_consumed",
